DEBUG=true
SECRET_KEY=change-moi-en-production
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=clameur
POSTGRES_USER=clameur
POSTGRES_PASSWORD=clameur_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Mistral : transcription Voxtral + embeddings
MISTRAL_API_KEY=

# Sunmi Cloud
SUNMI_APP_ID=
SUNMI_APP_KEY=
# Facultatif : le numero de serie de l'imprimante. Lu SEULEMENT si le champ
# des Reglages est vide dans la console : les Reglages l'emportent toujours.
SUNMI_PRINTER_SN=
URL_PUBLIQUE=http://localhost:8000

# --- Production (docker-compose-prod.yml) ---
# Le domaine sert a la fois a Traefik, a ALLOWED_HOSTS et au CSRF.
DOMAIN=clameur.exemple.fr
# URL_PUBLIQUE doit etre en https : elle est imprimee dans le QR des tickets.
# URL_PUBLIQUE=https://clameur.exemple.fr

# --- Obligations d'hebergeur (LCEN) ---
# Sans ces deux valeurs, `manage.py check --deploy` refuse le deploiement :
# personne ne pourrait signaler une clameur.
EDITEUR=
CONTACT=
